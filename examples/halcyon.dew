        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part sub {"
        },
        {
          "text": "    line root"
        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part bell {"
        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm   breathe"
        },
        {
          "text": "      contour  fall"
        },
        {
          "text": "      strong   chord-tones"
        },
        {
          "text": "      variance 0.2"
        },
        {
          "text": "      mute     1 of 3"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section close {"
        },
        {
          "text": "  length 4 bars"
        },
        {
          "text": "  harmony {"
        },
        {
          "text": "    II 1 bar | vi 1 bar | I 2 bars"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part pad {"
        },
        {
          "text": "    chords with wide"
        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
