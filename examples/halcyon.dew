    "score": {
      "name": "halcyon.score",
      "lines": [
        {
          "text": "// halcyon.score - the music behind the Halcyon demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// Ambient writing with a classical spine: a Lydian pedal that never resolves"
        },
        {
          "text": "// downward, an inner voice answering the bell in canon, and a bass that moves"
        },
        {
          "text": "// once a bar at most. The notes are here; the SOUND is built in"
        },
        {
          "text": "// demos/Halcyon.cpp - two wavetable pads, one morphing under its envelope and"
        },
        {
          "text": "// one under a free LFO, with a sine pair FM-ing each other for the bell."
        },
        {
          "text": "//"
        },
        {
          "text": "// 6/8 rather than 4/4, and not for novelty: the whole piece is a slow three"
        },
        {
          "text": "// against a slower two, and the compound metre is what lets a part hold across"
        },
        {
          "text": "// the middle of a bar without a tie."
        },
        {
          "text": "//"
        },
        {
          "text": "// The tempo counts BEATS, and in 6/8 a beat is an eighth - beatUnit is"
        },
        {
          "text": "// notational and never reaches the transport. So 208 here is a dotted quarter"
        },
        {
          "text": "// of about 69, which is the tempo this is actually written at. Reading it as"
        },
        {
          "text": "// 208 of anything you can tap is the mistake to avoid."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Halcyon\""
        },
        {
          "text": "  tempo 208 bpm"
        },
        {
          "text": "  meter 6/8"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   D lydian"
        },
        {
          "text": "  seed  0x4A1C0FDEED"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel pad {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    D3..D5"
        },
        {
          "text": "  velocity 29 +- 5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel veil {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    A3..A5"
        },
        {
          "text": "  velocity 25 +- 6 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel sub {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    D1..D3"
        },
        {
          "text": "  velocity 46 +- 3"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bell {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    D5..D6"
        },
        {
          "text": "  velocity 34 +- 9 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel answer {"
        },
        {
          "text": "  mixer    5"
        },
        {
          "text": "  range    A4..A5"
        },
        {
          "text": "  velocity 26 +- 6 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing wide {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   open"
        },
        {
          "text": "  register D3..D5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  5"
        },
        {
          "text": "  bass     from-inversion"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing airy {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   shell"
        },
        {
          "text": "  register A3..A5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "// A bar of 6/8 is six eighths - three quarters - so a rhythm that fills one is"
        },
        {
          "text": "// written as a dotted half. A 1/1 here would run a third of the way into the"
        },
        {
          "text": "// next bar, which is the trap a compound metre sets for a rhythm copied out of"
        },
        {
          "text": "// a 4/4 score."
        },
        {
          "text": "rhythm hold    { 1/2. }"
        },
        {
          "text": "rhythm breathe { 1/4 1/4 1/4 }"
        },
        {
          "text": "rhythm sway    { 1/4. 1/4. }"
        },
        {
          "text": "rhythm shimmer { 1/8 x5 - 1/8 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony pedal {"
        },
        {
          "text": "  I 2 bars | II 2 bars | vi 2 bars | V 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony lift {"
        },
        {
          "text": "  II 2 bars | vi 2 bars | iii 2 bars | V 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section open {"
        },
        {
          "text": "  length 4 bars"
        },
        {
          "text": "  harmony {"
        },
        {
          "text": "    I 2 bars | II 2 bars"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part pad {"
        },
        {
          "text": "    chords with wide"
        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section rise {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony pedal"
        },
        {
          "text": "  part pad {"
        },
        {
          "text": "    chords with wide"
        },
        {
