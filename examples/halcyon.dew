        },
        {
          "text": "  }"
        },
        {
          "text": "  part sub {"
        },
        {
          "text": "    line root"
        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section bloom {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony lift"
        },
        {
          "text": "  part pad {"
        },
        {
          "text": "    chords with wide"
        },
        {
          "text": "    rhythm breathe"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part veil {"
        },
        {
          "text": "    chords with airy"
        },
        {
          "text": "    rhythm sway"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part sub {"
        },
        {
          "text": "    line root-fifth"
        },
        {
          "text": "    rhythm breathe"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part bell {"
        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm       shimmer"
        },
        {
          "text": "      articulation legato"
        },
        {
          "text": "      contour      arch"
        },
        {
          "text": "      strong       chord-tones"
        },
        {
          "text": "      variance     0.3"
        },
        {
          "text": "      mute         1 of 4"
        },
        {
          "text": "      leap         max 7 resolve step"
        },
        {
          "text": "      align        bar"
        },
        {
          "text": "      cadence      choose [1 3 5] per instance"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part answer {"
        },
        {
          "text": "    imitate bell {"
        },
        {
          "text": "      delay     1 bar"
        },
        {
          "text": "      transpose -5"
        },
        {
          "text": "      mode      diatonic"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section turn {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony {"
        },
        {
          "text": "    vi 2 bars | iii 2 bars | II 2 bars | V 2 bars"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part pad {"
        },
        {
          "text": "    chords with wide"
        },
        {
          "text": "    rhythm sway"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part veil {"
        },
        {
          "text": "    chords with airy"
        },
        {
          "text": "    rhythm breathe"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part sub {"
        },
        {
          "text": "    line root"
        },
        {
          "text": "    rhythm hold"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part bell {"
        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm   sway"
        },
        {
          "text": "      contour  wave"
        },
        {
          "text": "      strong   chord-tones"
        },
        {
          "text": "      variance 0.25"
        },
        {
          "text": "      mute     1 of 3"
        },
        {
          "text": "      align    bar"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part answer {"
        },
        {
          "text": "    counterpoint against bell {"
        },
        {
          "text": "      rhythm               breathe"
        },
        {
          "text": "      articulation         legato"
        },
        {
          "text": "      parallel-fifths      forbid"
        },
        {
          "text": "      parallel-octaves     forbid"
        },
        {
          "text": "      voice-crossing       forbid"
        },
        {
          "text": "      dissonance-on-strong soft 3"
        },
        {
          "text": "      leaps                soft 1.5"
        },
        {
          "text": "      repeats              soft 1"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section wane {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony pedal"
        },
        {
