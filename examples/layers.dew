    "score": {
      "name": "neon.score",
      "lines": [
        {
          "text": "// neon.score - the music behind the Oscillator Stack demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// Four parts and nothing exotic in the writing, on purpose: this demo is about"
        },
        {
          "text": "// what ONE channel is made of, and a busy arrangement would talk over it. Each"
        },
        {
          "text": "// channel below is adopted by name in Demos.cpp and given three oscillators -"
        },
        {
          "text": "// an octave apart, a few cents off each other, at different gains - which is"
        },
        {
          "text": "// the whole of the sound and none of the notes."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Neon\""
        },
        {
          "text": "  tempo 108 bpm"
        },
        {
          "text": "  meter 4/4"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   C minor"
        },
        {
          "text": "  seed  0x00FF1CE5EED"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel lead {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    C4..C6"
        },
        {
          "text": "  velocity 70 +- 7"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel pad {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    C3..C5"
        },
        {
          "text": "  velocity 46 +- 5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bass {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    C1..C3"
        },
        {
          "text": "  velocity 82 +- 4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel arp {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    G3..G5"
        },
        {
          "text": "  velocity 58 +- 8 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing bed {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   open"
        },
        {
          "text": "  register C3..C5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  7"
        },
        {
          "text": "  bass     from-inversion"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "rhythm held    { 1/1 }"
        },
        {
          "text": "rhythm halves  { 1/2 1/2 }"
        },
        {
          "text": "rhythm pulse   { 1/4 1/4 1/2 }"
        },
        {
          "text": "rhythm running { 1/8 x6 - 1/8 1/8 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony engine {"
        },
        {
          "text": "  i x2 | bVI x2 | bIII x2 | bVII x2"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony lift {"
        },
        {
          "text": "  bVI | bVII | i x2 | bIII | bVII | i x2"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section neon_intro {"
        },
        {
          "text": "  length 4 bars"
        },
        {
          "text": "  harmony {"
        },
        {
          "text": "    i 2 bars | bVI 1 bar | bVII 1 bar"
