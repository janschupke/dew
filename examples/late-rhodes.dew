    "score": {
      "name": "rhodes.score",
      "lines": [
        {
          "text": "// rhodes.score - the music behind the Late Rhodes demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// A neo-soul ballad in Eb: rootless and drop-2 voicings over a walking-ish"
        },
        {
          "text": "// bass, secondary dominants, and a tritone substitution into the last cadence."
        },
        {
          "text": "// The notes are here; the SOUND is built in demos/LateRhodes.cpp - and it is an"
        },
        {
          "text": "// FM electric piano, because that is what an electric piano IS: a sine carrier"
        },
        {
          "text": "// with a sine an octave above it folded into its phase, and a third slot for"
        },
        {
          "text": "// the tine."
        },
        {
          "text": "//"
        },
        {
          "text": "// Swung, not straight. The rhythms below are written in triplet eighths, which"
        },
        {
          "text": "// is what puts the grid at twelve steps to a beat - the value the language"
        },
        {
          "text": "// derives rather than one anybody chose."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Late Rhodes\""
        },
        {
          "text": "  tempo 78 bpm"
        },
        {
          "text": "  meter 4/4"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   Eb major"
        },
        {
          "text": "  seed  0x5A17ED0C0A"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel rhodes {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    Eb3..Eb5"
        },
        {
          "text": "  velocity 38 +- 11 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bass {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    Eb1..Eb3"
        },
        {
          "text": "  velocity 47 +- 6 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel pad {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    Bb3..Bb5"
        },
        {
          "text": "  velocity 22 +- 4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel horn {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    Eb4..Eb5"
        },
        {
          "text": "  velocity 39 +- 10 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing rootless {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   rootless"
        },
        {
          "text": "  register Eb3..Eb5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  5"
        },
        {
          "text": "  bass     any"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing spread {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   drop2"
        },
        {
          "text": "  register Bb2..Bb4"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  7"
        },
        {
          "text": "  bass     from-inversion"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing upper {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   shell"
        },
        {
          "text": "  register Bb3..Bb5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "// Long-short: a triplet quarter against a triplet eighth is the shuffle this is"
        },
        {
          "text": "// played with, and writing it out is the only way dew can hold it - a step grid"
        },
        {
          "text": "// has no swing knob, so the swing has to be in the grid itself."
        },
        {
          "text": "rhythm swung   { 1/4t 1/8t 1/4t 1/8t 1/4t 1/8t 1/4t 1/8t }"
        },
        {
          "text": "rhythm comp    { 1/4 - 1/8 1/8 1/4 1/4 }"
        },
        {
          "text": "rhythm hold    { 1/1 }"
        },
        {
          "text": "rhythm walk    { 1/4 1/4 1/4 1/8 1/8 }"
        },
        {
          "text": "rhythm fill    { 1/8t x6 1/16 x4 1/4 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony head {"
        },
        {
          "text": "  I 1 bar | vi 1 bar | ii 2 bars | V7 2 bars | I 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony turn {"
        },
        {
          "text": "  iii 1 bar | V7/ii 1 bar | ii 2 bars | bII7 1 bar | I 1 bar | IV 1 bar | V7 1 bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section head {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony head"
        },
        {
          "text": "  part rhodes {"
        },
        {
          "text": "    chords with rootless"
        },
        {
          "text": "    rhythm comp"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part bass {"
        },
        {
          "text": "    line root-fifth"
        },
        {
          "text": "    rhythm walk"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section verse {"
        },
        {
          "text": "  length 8 bars"
        },
