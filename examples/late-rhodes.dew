        },
        {
          "text": "  }"
        },
        {
          "text": "  part horn {"
        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm       swung"
        },
        {
          "text": "      articulation legato"
        },
        {
          "text": "      contour      arch"
        },
        {
          "text": "      strong       chord-tones"
        },
        {
          "text": "      variance     0.3"
        },
        {
          "text": "      mute         1 of 3"
        },
        {
          "text": "      leap         max 7 resolve step"
        },
        {
          "text": "      align        bar"
        },
        {
          "text": "      cadence      choose [1 3 5] per instance"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
