              "ratio": 4.0,
              "attackMs": 10.0,
              "releaseMs": 100.0,
              "makeup": 0.0,
              "ceiling": -0.3
            }
          ]
        },
        {
          "id": 4,
          "name": "horn",
          "gain": 0.52,
          "pan": -0.1,
          "mute": false,
          "colour": "",
          "effects": [
            {
              "id": 5,
              "type": "delay",
              "enabled": true,
              "mix": 0.24,
              "filterMode": "lowpass",
              "cutoff": 1200.0,
              "resonance": 0.4,
              "roomSize": 0.5,
              "damping": 0.5,
              "width": 1.0,
              "delayMs": 462.0,
              "feedback": 0.3,
              "drive": 2.0,
              "outputGain": 1.0,
              "distortionMode": "softClip",
              "tone": 0.5,
              "rate": 1.2,
              "depth": 0.3,
              "centreFreq": 600.0,
              "lowGainDb": 0.0,
              "midGainDb": 0.0,
              "midFreq": 900.0,
              "highGainDb": 0.0,
              "threshold": -18.0,
              "ratio": 4.0,
