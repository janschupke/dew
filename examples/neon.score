// neon.score - the music behind the Oscillator Stack demo.
//
// Four parts and nothing exotic in the writing, on purpose: this demo is about
// what ONE channel is made of, and a busy arrangement would talk over it. Each
// channel below is adopted by name in Demos.cpp and given three oscillators -
// an octave apart, a few cents off each other, at different gains - which is
// the whole of the sound and none of the notes.

song {
  title "Neon"
  tempo 108 bpm
  meter 4/4
  grid  auto
  key   C minor
  seed  0x00FF1CE5EED
}

channel lead {
  mixer    1
  range    C4..C6
  velocity 70 +- 7
}

channel pad {
  mixer    2
  range    C3..C5
  velocity 46 +- 5
}

channel bass {
  mixer    3
  range    C1..C3
  velocity 82 +- 4
}

channel arp {
  mixer    4
  range    G3..G5
  velocity 58 +- 8 per bar
}

voicing bed {
  size     4 voices
  spread   open
  register C3..C5
  motion   smooth
  maxLeap  7
  bass     from-inversion
}

rhythm held    { 1/1 }
rhythm halves  { 1/2 1/2 }
rhythm pulse   { 1/4 1/4 1/2 }
rhythm running { 1/8 x6 - 1/8 1/8 }

harmony engine {
  i x2 | bVI x2 | bIII x2 | bVII x2
}

harmony lift {
  bVI | bVII | i x2 | bIII | bVII | i x2
}

section neon_intro {
  length 4 bars
  harmony {
    i 2 bars | bVI 1 bar | bVII 1 bar
  }
  part pad {
    chords with bed
    rhythm held
  }
  part bass {
    line root
    rhythm halves
  }
}

section verse {
  length 8 bars
  harmony engine
  part pad {
    chords with bed
    rhythm held
  }
  part bass {
    line root-fifth
    rhythm pulse
  }
  part arp {
    melody {
      rhythm       running
      articulation detached
      contour      wave
      strong       chord-tones
      variance     0.3
      align        continuous
    }
  }
}

section chorus {
  length 8 bars
  harmony lift
  part pad {
    chords with bed
    rhythm halves
  }
  part bass {
    line root
    rhythm running
  }
  part arp {
    melody {
      rhythm   running
      contour  rise
      strong   chord-tones
      variance 0.4
      align    continuous
    }
  }
  part lead {
    melody {
      rhythm       pulse
      articulation legato
      contour      arch
      strong       chord-tones
      variance     0.25
      leap         max 7 resolve step
      cadence      choose [1 3 5] per instance
    }
  }
}

section outro {
  length 4 bars
  harmony {
    bVI 1 bar | bVII 1 bar | i 2 bars
  }
  part pad {
    chords with bed
    rhythm held
  }
  part bass {
    line root
    rhythm halves
  }
}

arrangement {
  neon_intro
  verse
  chorus
  verse as verse_b
  outro
}
