// drift.score - the music behind the Wavetable demo.
//
// The notes are here; the SOUND is not. Every channel below is adopted by name
// in Demos.cpp and dressed there: five different wavetables, unison stacks, and
// a morph position that moves under an LFO on the held voices and under the
// envelope on the struck ones. That split is the language's own - it owns
// notes, patterns and clips, and the user owns the instrument and the mixer.
//
// Slow on purpose. A wavetable morph is a thing you hear over bars, not beats,
// so the parts hold and the harmony turns underneath them.

song {
  title "Drift"
  tempo 84 bpm
  meter 4/4
  grid  auto
  key   D minor
  seed  0x0DEFACEDBEEF
}

channel pad {
  mixer    1
  range    C3..C5
  velocity 48 +- 5
}

channel swell {
  mixer    2
  range    G3..G5
  velocity 40 +- 6
}

channel sub {
  mixer    3
  range    D1..D3
  velocity 78 +- 3
}

channel bell {
  mixer    4
  range    D4..D6
  velocity 58 +- 9
}

channel answer {
  mixer    5
  range    A3..A5
  velocity 44 +- 6 per bar
}

voicing wide {
  size     4 voices
  spread   open
  register C3..C5
  motion   smooth
  maxLeap  5
  bass     from-inversion
}

voicing upper {
  size     3 voices
  spread   shell
  register G3..G5
  motion   smooth
}

rhythm hold    { 1/1 }
rhythm breathe { 1/2 1/2 }
rhythm drift   { 1/4 1/4 1/2 }
rhythm shimmer { 1/8 x6 - 1/8 1/8 }

harmony still {
  i x2 | bVI x2 | iv x2 | bVII x2
}

harmony opening {
  bVI | bVII | i x2 | iv | V7 | i x2
}

section haze {
  length 4 bars
  harmony {
    i 2 bars | bVI 1 bar | bVII 1 bar
  }
  part pad {
    chords with wide
    rhythm hold
  }
}

section gather {
  length 8 bars
  harmony still
  part pad {
    chords with wide
    rhythm hold
  }
  part swell {
    chords with upper
    rhythm breathe
  }
  part sub {
    line root
    rhythm breathe
  }
}

section bloom {
  length 8 bars
  harmony opening
  part pad {
    chords with wide
    rhythm breathe
  }
  part swell {
    chords with upper
    rhythm drift
  }
  part sub {
    line root-fifth
    rhythm drift
  }
  part bell {
    melody {
      rhythm       shimmer
      articulation legato
      contour      arch
      strong       chord-tones
      variance     0.35
      mute         1 of 4
      cadence      choose [1 3 5] per instance
    }
  }
  part answer {
    counterpoint against bell {
      rhythm               drift
      parallel-fifths      forbid
      parallel-octaves     forbid
      voice-crossing       forbid
      dissonance-on-strong soft 3
      leaps                soft 1.5
      repeats              soft 1
    }
  }
}

section ebb {
  length 8 bars
  harmony still
  part pad {
    chords with wide
    rhythm hold
  }
  part sub {
    line root
    rhythm breathe
  }
  part bell {
    melody {
      rhythm   drift
      contour  fall
      strong   chord-tones
      variance 0.2
      mute     1 of 3
    }
  }
}

section fade {
  length 4 bars
  harmony {
    iv 1 bar | bVII 1 bar | i 2 bars
  }
  part pad {
    chords with wide
    rhythm hold
  }
}

arrangement {
  haze
  gather
  bloom
  ebb
  fade
}
