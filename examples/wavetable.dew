    "score": {
      "name": "drift.score",
      "lines": [
        {
          "text": "// drift.score - the music behind the Wavetable demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// The notes are here; the SOUND is not. Every channel below is adopted by name"
        },
        {
          "text": "// in Demos.cpp and dressed there: five different wavetables, unison stacks, and"
        },
        {
          "text": "// a morph position that moves under an LFO on the held voices and under the"
        },
        {
          "text": "// envelope on the struck ones. That split is the language's own - it owns"
        },
        {
          "text": "// notes, patterns and clips, and the user owns the instrument and the mixer."
        },
        {
          "text": "//"
        },
        {
          "text": "// Slow on purpose. A wavetable morph is a thing you hear over bars, not beats,"
        },
        {
          "text": "// so the parts hold and the harmony turns underneath them."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Drift\""
        },
        {
          "text": "  tempo 84 bpm"
        },
        {
          "text": "  meter 4/4"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   D minor"
        },
        {
          "text": "  seed  0x0DEFACEDBEEF"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel pad {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    C3..C5"
        },
        {
          "text": "  velocity 48 +- 5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel swell {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    G3..G5"
        },
        {
          "text": "  velocity 40 +- 6"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel sub {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    D1..D3"
        },
        {
          "text": "  velocity 78 +- 3"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bell {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    D4..D6"
        },
        {
          "text": "  velocity 58 +- 9"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel answer {"
        },
        {
          "text": "  mixer    5"
        },
        {
          "text": "  range    A3..A5"
        },
        {
          "text": "  velocity 44 +- 6 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing wide {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   open"
        },
        {
          "text": "  register C3..C5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  5"
        },
        {
          "text": "  bass     from-inversion"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing upper {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   shell"
        },
        {
          "text": "  register G3..G5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "rhythm hold    { 1/1 }"
        },
        {
          "text": "rhythm breathe { 1/2 1/2 }"
        },
        {
          "text": "rhythm drift   { 1/4 1/4 1/2 }"
        },
        {
          "text": "rhythm shimmer { 1/8 x6 - 1/8 1/8 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony still {"
        },
        {
          "text": "  i x2 | bVI x2 | iv x2 | bVII x2"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony opening {"
        },
        {
          "text": "  bVI | bVII | i x2 | iv | V7 | i x2"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
