// amber.score - the example the tests and CI compile.
//
// Deliberately audible: pads holding the harmony, a bass on the roots, a lead
// line over the top and a second voice answering it. A compile that produces
// silence is obviously wrong.

song {
  title "Amber"
  tempo 96 bpm
  meter 4/4
  grid  auto
  key   F minor
  seed  0x5EEDC0FFEE
}

channel pad {
  mixer    1
  range    C3..C5
  velocity 52 +- 6
}

channel bass {
  mixer    2
  range    E1..E3
  velocity 76 +- 4
}

channel lead {
  mixer    3
  range    F4..A5
  velocity 66 +- 8
}

channel answer {
  mixer    4
  range    F3..F5
  velocity 54 +- 6 per bar
}

voicing warm {
  size     4 voices
  spread   drop2
  register C3..C5
  motion   smooth
  maxLeap  7
  bass     from-inversion
}

rhythm held    { 1/1 }
rhythm pulse   { 1/4 1/4 1/2 }
rhythm running { 1/8 x6 - 1/8 1/8 }

harmony lament {
  i x2 | bVI | bVII | i^1 x2 | iv | V7/iv
}

harmony lift {
  bVI | bVII | i x2 | bVI | bVII | V7 | i
}

section intro {
  length 4 bars
  harmony {
    i 2 bars | bVI 1 bar | V7 1 bar
  }
  part pad {
    chords with warm
    rhythm held
  }
}

section verse {
  length 8 bars
  harmony lament
  part pad {
    chords with warm
    rhythm held
  }
  part bass {
    line root-fifth
    rhythm pulse
  }
  part lead {
    melody {
      rhythm       pulse
      articulation legato
      contour      arch
      strong       chord-tones
      variance     0.25
      mute         1 of 4
      cadence      choose [1 3 5] per instance
    }
  }
  part answer {
    counterpoint against lead {
      rhythm               pulse
      parallel-fifths      forbid
      parallel-octaves     forbid
      voice-crossing       forbid
      dissonance-on-strong soft 3
      leaps                soft 1.5
      repeats              soft 1
    }
  }
}

section chorus {
  length 8 bars
  harmony lift
  part pad {
    chords with warm
    rhythm pulse
  }
  part bass {
    line root
    rhythm running
  }
  part lead {
    melody {
      rhythm   running
      contour  rise
      strong   chord-tones
      variance 0.4
    }
  }
}

arrangement {
  intro
  verse
  verse as verse_b
  chorus
  verse
  chorus x2 identical
}
