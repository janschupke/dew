    "score": {
      "name": "amber.score",
      "lines": [
        {
          "text": "// amber.score - the example the tests and CI compile."
        },
        {
          "text": "//"
        },
        {
          "text": "// Deliberately audible: pads holding the harmony, a bass on the roots, a lead"
        },
        {
          "text": "// line over the top and a second voice answering it. A compile that produces"
        },
        {
          "text": "// silence is obviously wrong."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Amber\""
        },
        {
          "text": "  tempo 96 bpm"
        },
        {
          "text": "  meter 4/4"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   F minor"
        },
        {
          "text": "  seed  0x5EEDC0FFEE"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel pad {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    C3..C5"
        },
        {
          "text": "  velocity 52 +- 6"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bass {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    E1..E3"
        },
        {
          "text": "  velocity 76 +- 4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel lead {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    F4..A5"
        },
        {
          "text": "  velocity 66 +- 8"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel answer {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    F3..F5"
        },
        {
          "text": "  velocity 54 +- 6 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing warm {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   drop2"
        },
        {
          "text": "  register C3..C5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  7"
        },
        {
