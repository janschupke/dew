        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm   lace"
        },
        {
          "text": "      contour  fall"
        },
        {
          "text": "      strong   scale-tones"
        },
        {
          "text": "      variance 0.45"
        },
        {
          "text": "      align    bar"
