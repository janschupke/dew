        },
        {
          "text": "  }"
        },
        {
          "text": "  part lead {"
        },
        {
          "text": "    melody {"
        },
        {
          "text": "      rhythm       split"
        },
        {
          "text": "      articulation detached"
        },
        {
          "text": "      contour      wave"
        },
        {
          "text": "      strong       chord-tones"
        },
        {
          "text": "      variance     0.35"
        },
        {
          "text": "      mute         1 of 4"
        },
        {
          "text": "      leap         max 9 resolve step"
        },
        {
          "text": "      align        bar"
        },
        {
          "text": "    }"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
