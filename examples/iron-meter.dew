    "score": {
      "name": "ironmeter.score",
      "lines": [
        {
          "text": "// ironmeter.score - the music behind the Iron Meter demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// Math rock in seven: a riff that regroups 2+2+3 against 3+2+2 over the same"
        },
        {
          "text": "// bar, a bridge that drops from Mixolydian into Phrygian without changing key"
        },
        {
          "text": "// centre, and a lead that has to fit its phrases into a bar that is one eighth"
        },
        {
          "text": "// short of the one it wants. The notes are here; the SOUND is built in"
        },
        {
          "text": "// demos/IronMeter.cpp, and so is the kit - a score writes pitched parts, and a"
        },
        {
          "text": "// drum part is placement rather than harmony."
        },
        {
          "text": "//"
        },
        {
          "text": "// The tempo counts BEATS, and in 7/8 a beat is an eighth. 294 here is a quarter"
        },
        {
          "text": "// of about 147, which is the tempo this is played at."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Iron Meter\""
        },
        {
          "text": "  tempo 294 bpm"
        },
        {
          "text": "  meter 7/8"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   E mixolydian"
        },
        {
          "text": "  seed  0x17E80FEED5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel guitar {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    E2..E4"
        },
        {
          "text": "  velocity 51 +- 8 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel bass {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    E1..E3"
        },
        {
          "text": "  velocity 53 +- 5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel keys {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    B3..B5"
        },
        {
          "text": "  velocity 31 +- 7 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel lead {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    E4..E6"
        },
        {
          "text": "  velocity 44 +- 10 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing stack {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   open"
        },
        {
          "text": "  register E3..E5"
        },
        {
          "text": "  motion   parallel"
        },
        {
          "text": "  maxLeap  7"
        },
        {
          "text": "  bass     root"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing tight {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   close"
        },
        {
          "text": "  register B3..B5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  4"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "// A bar is seven eighths, and the two groupings the piece plays against each"
        },
        {
          "text": "// other are both written out. `drive` is 2+2+3; `push` is 3+2+2. Nothing in the"
        },
        {
          "text": "// language knows they are the same bar counted differently - that is the point"
        },
        {
          "text": "// of putting both in front of the reader."
        },
        {
          "text": "rhythm drive { 1/4 1/4 1/4. }"
        },
        {
          "text": "rhythm push  { 1/4. 1/4 1/4 }"
        },
        {
          "text": "rhythm chug  { 1/8 x7 }"
        },
        {
          "text": "rhythm split { 1/8 1/8 1/4 1/8 1/8 1/8 }"
        },
        {
          "text": "rhythm lace  { 1/16 x6 1/8 1/8 1/4 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony ground {"
        },
        {
          "text": "  I 2 bars | VII 2 bars | IV 2 bars | I 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony climb {"
        },
        {
          "text": "  IV 2 bars | v 2 bars | VII 2 bars | I 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "// The bridge keeps E under it and changes what the scale does above it. A local"
        },
        {
          "text": "// key on a harmony block is how a piece modulates without the SONG's key - and"
        },
        {
          "text": "// therefore every other section's numerals - moving with it."
        },
        {
          "text": "harmony dark {"
        },
        {
          "text": "  key E phrygian"
        },
        {
          "text": "  i 2 bars | bII 2 bars | i 2 bars | bVII 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section riff {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony ground"
        },
        {
          "text": "  part guitar {"
        },
        {
          "text": "    chords with stack"
        },
        {
          "text": "    rhythm drive"
        },
        {
          "text": "  }"
        },
        {
          "text": "  part bass {"
        },
        {
          "text": "    line root"
        },
        {
          "text": "    rhythm push"
        },
        {
          "text": "  }"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section verse {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony ground"
        },
