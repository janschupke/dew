    "score": {
      "name": "nightfall.score",
      "lines": [
        {
          "text": "// nightfall.score - the music behind the Nightfall Waltz demo."
        },
        {
          "text": "//"
        },
        {
          "text": "// A string quartet's worth of writing in D harmonic minor: a waltz theme, an"
        },
        {
          "text": "// answering voice under real counterpoint rules, and a canon at the fourth. The"
        },
        {
          "text": "// notes are here; the SOUND is built in demos/NightfallWaltz.cpp - detuned"
        },
        {
          "text": "// triangle stacks placed across the stereo field the way an ensemble sits, and"
        },
        {
          "text": "// nothing a dance mix would do to them."
        },
        {
          "text": "//"
        },
        {
          "text": "// Every numeral below is BARE, and that is deliberate. An accidental reads"
        },
        {
          "text": "// against the major scale while a bare numeral reads against the mode, and"
        },
        {
          "text": "// harmonic minor already has a flat sixth - so `bVI` here would flatten it"
        },
        {
          "text": "// twice and land a semitone under the Bb this piece is about."
        },
        {
          "text": ""
        },
        {
          "text": "song {"
        },
        {
          "text": "  title \"Nightfall Waltz\""
        },
        {
          "text": "  tempo 96 bpm"
        },
        {
          "text": "  meter 3/4"
        },
        {
          "text": "  grid  auto"
        },
        {
          "text": "  key   D harmonic-minor"
        },
        {
          "text": "  seed  0x0DE1AB0DE"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel violin {"
        },
        {
          "text": "  mixer    1"
        },
        {
          "text": "  range    D4..D6"
        },
        {
          "text": "  velocity 40 +- 9 per note"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel viola {"
        },
        {
          "text": "  mixer    2"
        },
        {
          "text": "  range    A3..A5"
        },
        {
          "text": "  velocity 35 +- 7 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel cello {"
        },
        {
          "text": "  mixer    3"
        },
        {
          "text": "  range    D2..D4"
        },
        {
          "text": "  velocity 43 +- 5"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "channel clarinet {"
        },
        {
          "text": "  mixer    4"
        },
        {
          "text": "  range    D4..A5"
        },
        {
          "text": "  velocity 32 +- 8 per bar"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing chamber {"
        },
        {
          "text": "  size     3 voices"
        },
        {
          "text": "  spread   close"
        },
        {
          "text": "  register A3..A5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  4"
        },
        {
          "text": "  bass     root"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "voicing open {"
        },
        {
          "text": "  size     4 voices"
        },
        {
          "text": "  spread   drop2"
        },
        {
          "text": "  register D3..D5"
        },
        {
          "text": "  motion   smooth"
        },
        {
          "text": "  maxLeap  7"
        },
        {
          "text": "  bass     from-inversion"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "// A bar is three quarters. `turn` is the waltz figure the theme is built from;"
        },
        {
          "text": "// `flourish` is the only thing here that needs sixteenths, and it is what puts"
        },
        {
          "text": "// the grid at four steps to a beat rather than two."
        },
        {
          "text": "rhythm waltz    { 1/4 1/4 1/4 }"
        },
        {
          "text": "rhythm hold     { 1/2. }"
        },
        {
          "text": "rhythm lilt     { 1/2 1/4 }"
        },
        {
          "text": "rhythm turn     { 1/4 1/8 1/8 1/4 }"
        },
        {
          "text": "rhythm flourish { 1/16 x4 1/8 1/8 1/4 }"
        },
        {
          "text": ""
        },
        {
          "text": "harmony descent {"
        },
        {
          "text": "  i 2 bars | vii 1 bar | i 1 bar | iv 2 bars | V 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "harmony answer {"
        },
        {
          "text": "  VI 2 bars | ii 2 bars | V 2 bars | i 2 bars"
        },
        {
          "text": "}"
        },
        {
          "text": ""
        },
        {
          "text": "section theme {"
        },
        {
          "text": "  length 8 bars"
        },
        {
          "text": "  harmony descent"
        },
        {
          "text": "  part cello {"
