// halcyon.score - the music behind the Halcyon demo.
//
// Ambient writing with a classical spine: a Lydian pedal that never resolves
// downward, an inner voice answering the bell in canon, and a bass that moves
// once a bar at most. The notes are here; the SOUND is built in
// demos/Halcyon.cpp - two wavetable pads, one morphing under its envelope and
// one under a free LFO, with a sine pair FM-ing each other for the bell.
//
// 6/8 rather than 4/4, and not for novelty: the whole piece is a slow three
// against a slower two, and the compound metre is what lets a part hold across
// the middle of a bar without a tie.
//
// The tempo counts BEATS, and in 6/8 a beat is an eighth - beatUnit is
// notational and never reaches the transport. So 208 here is a dotted quarter
// of about 69, which is the tempo this is actually written at. Reading it as
// 208 of anything you can tap is the mistake to avoid.

song {
  title "Halcyon"
  tempo 208 bpm
  meter 6/8
  grid  auto
  key   D lydian
  seed  0x4A1C0FDEED
}

channel pad {
  mixer    1
  range    D3..D5
  velocity 29 +- 5
}

channel veil {
  mixer    2
  range    A3..A5
  velocity 25 +- 6 per bar
}

channel sub {
  mixer    3
  range    D1..D3
  velocity 46 +- 3
}

channel bell {
  mixer    4
  range    D5..D6
  velocity 34 +- 9 per note
}

channel answer {
  mixer    5
  range    A4..A5
  velocity 26 +- 6 per bar
}

voicing wide {
  size     4 voices
  spread   open
  register D3..D5
  motion   smooth
  maxLeap  5
  bass     from-inversion
}

voicing airy {
  size     3 voices
  spread   shell
  register A3..A5
  motion   smooth
  maxLeap  4
}

// A bar of 6/8 is six eighths - three quarters - so a rhythm that fills one is
// written as a dotted half. A 1/1 here would run a third of the way into the
// next bar, which is the trap a compound metre sets for a rhythm copied out of
// a 4/4 score.
rhythm hold    { 1/2. }
rhythm breathe { 1/4 1/4 1/4 }
rhythm sway    { 1/4. 1/4. }
rhythm shimmer { 1/8 x5 - 1/8 }

harmony pedal {
  I 2 bars | II 2 bars | vi 2 bars | V 2 bars
}

harmony lift {
  II 2 bars | vi 2 bars | iii 2 bars | V 2 bars
}

section open {
  length 4 bars
  harmony {
    I 2 bars | II 2 bars
  }
  part pad {
    chords with wide
    rhythm hold
  }
}

section rise {
  length 8 bars
  harmony pedal
  part pad {
    chords with wide
    rhythm hold
  }
  part veil {
    chords with airy
    rhythm sway
  }
  part sub {
    line root
    rhythm hold
  }
}

section bloom {
  length 8 bars
  harmony lift
  part pad {
    chords with wide
    rhythm breathe
  }
  part veil {
    chords with airy
    rhythm sway
  }
  part sub {
    line root-fifth
    rhythm breathe
  }
  part bell {
    melody {
      rhythm       shimmer
      articulation legato
      contour      arch
      strong       chord-tones
      variance     0.3
      mute         1 of 4
      leap         max 7 resolve step
      align        bar
      cadence      choose [1 3 5] per instance
    }
  }
  part answer {
    imitate bell {
      delay     1 bar
      transpose -5
      mode      diatonic
    }
  }
}

section turn {
  length 8 bars
  harmony {
    vi 2 bars | iii 2 bars | II 2 bars | V 2 bars
  }
  part pad {
    chords with wide
    rhythm sway
  }
  part veil {
    chords with airy
    rhythm breathe
  }
  part sub {
    line root
    rhythm hold
  }
  part bell {
    melody {
      rhythm   sway
      contour  wave
      strong   chord-tones
      variance 0.25
      mute     1 of 3
      align    bar
    }
  }
  part answer {
    counterpoint against bell {
      rhythm               breathe
      articulation         legato
      parallel-fifths      forbid
      parallel-octaves     forbid
      voice-crossing       forbid
      dissonance-on-strong soft 3
      leaps                soft 1.5
      repeats              soft 1
    }
  }
}

section wane {
  length 8 bars
  harmony pedal
  part pad {
    chords with wide
    rhythm hold
  }
  part veil {
    chords with airy
    rhythm hold
  }
  part sub {
    line root
    rhythm hold
  }
  part bell {
    melody {
      rhythm   breathe
      contour  fall
      strong   chord-tones
      variance 0.2
      mute     1 of 3
    }
  }
}

section close {
  length 4 bars
  harmony {
    II 1 bar | vi 1 bar | I 2 bars
  }
  part pad {
    chords with wide
    rhythm hold
  }
  part sub {
    line root
    rhythm hold
  }
}

arrangement {
  open
  rise
  bloom
  turn
  bloom
  wane
  close
}
