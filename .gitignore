# Build trees (see CMakePresets.json)
/build/
/out/

# macOS
.DS_Store

# Editor
/.vscode/
/.idea/
*.swp

# Local overrides
CMakeUserPresets.json

# The website. /build/ and /out/ above are anchored to the repo root by their
# leading slash, so they cover neither of the site's own build trees.
/website/node_modules/
/website/.next/
/website/out/
/website/tsconfig.tsbuildinfo

# Vercel's local state. vercel.json at the root is committed and is the whole
# of the configuration; this is what `vercel` writes beside it.
/.vercel/
